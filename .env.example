# Royal Hints Environment Variables
PORT=3000
# cPanel commonly uses localhost when the app and MariaDB are on the same account.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false
# Use a persistent cPanel directory outside release/build directories when available.
IMAGE_UPLOAD_DIR=uploads/catalog
ADMIN_EMAIL=
ADMIN_PASSWORD=
